@namespace Gamejam.UI

@inherits Panel
@attribute [StyleSheet]

<root>
	@if ( Player.Local?.Inventory != null )
	{
		@for ( var slotId = 0; slotId < Player.Local.Inventory.NUM_SLOTS; slotId++ )
		{
			var item = Player.Local.Inventory.GetItemAtSlot( slotId );
			<InventorySlot SlotId=@slotId Item=@item Selected=@(SelectedSlotId == slotId) />
		}
	}
</root>

@code
{
	private int SelectedSlotId { get; set; } = -1;

	public override void Tick()
	{
		if ( Player.Local?.Inventory == null ) return;

		for ( var slotId = 0; slotId < Player.Local.Inventory.NUM_SLOTS; slotId++ )
		{
			if ( Input.Pressed( $"Slot{slotId+1}" ) )
			{
				SelectedSlotId = SelectedSlotId == slotId ? -1 : slotId;
			}
		}
	}

	protected override int BuildHash()
	{
		if ( Player.Local?.Inventory == null ) return HashCode.Combine( SelectedSlotId );
		return HashCode.Combine( SelectedSlotId, Player.Local.Inventory.Items.HashCombine( i => i?.GetHashCode() ?? -1 ) );
	}
}
