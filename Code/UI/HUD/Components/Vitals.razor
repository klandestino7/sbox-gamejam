@using Sandbox
@using Sandbox.UI
@using System.Text

@inherits Panel
@attribute [StyleSheet]

@namespace Gamejam.UI

@if ( !Player.IsValid() || !HealthSystem.IsValid() ) return;

<root class="@BuildClass()">

    <div class="inner with-padding flex row gap justify-start">
        <div class="flex column">
   
        </div>

        <div class="flex column">
            <ProgressBar Value="@(Health)" width="128" />
            <span class="flex row align-center gap-sm">
                <label class="vital">@Health</label>
            </span>
        </div>
    </div>

</root>

@code
{
    public Player Player => PlayerState.Viewer.Player;
    public HealthSystem HealthSystem => Player.HealthSystem;
    public int Health => HealthSystem?.Health ?? 0;
    public int Oxigen => HealthSystem?.Oxigen ?? 0;

    protected override int BuildHash()
    {
        return !Player.IsValid() ? 0 : System.HashCode.Combine( Player, HealthSystem, Health, Oxigen );
    }

    private string BuildClass()
    {
        var sb = new StringBuilder();
        
        if ( Health < 30f )
            sb.Append( "low-health" );
        
        return sb.ToString();
    }
}