@using Sandbox;
@using Sandbox.UI;

@namespace Gamejam.UI
@implements INavigatorPage

<root class="hc1">
    <Page>
        <Body>
            <div class="inset column" >
                <div class="flex padding-extra gap column">
                    <a class="button current" href="/new"><i>play_circle_outline</i> Play With Friends </a>
                    <a class="button" href=""><i>dns</i> Join Random </a>
                    <a class="button" href="/settings"><i>settings</i> Options </a>
                    <a class="button" href="/credits"><i>dns</i> Credits </a>
                    <a class="button" onclick=@(()=>Quit())><i>power_settings_new</i> Quit </a>
                </div>
            </div>
        </Body>
    </Page>
</root>

@code
{
    void Quit()
    {
        Game.Close();
    }
}
