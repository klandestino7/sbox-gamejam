@namespace Gamejam.UI

@inherits Panel
@implements INavigatorPage

<root>
    <Page>

        <Header>
            Host Private Game
        </Header>

        <SubHeader>
            Select a space to save host
        </SubHeader>

        <Body>
            <div class="layout row gap-insane">
                @for ( var slotId = 0; slotId < 3; slotId++ )
                {
                    <div class="@IsActiveSlot(slotId)" onclick=@( () => SelectSlot( @slotId ) ) > 
                        <div class="slot"> Empty </div>
                        <div class="name "> Save @(slotId + 1) </div>
                    </div>
                }
            </div>
        </Body>

        <SubFooter>
            <div class="button standard" onclick=@Join> host </div>
        </SubFooter>
    </Page>
</root>

@code
{
    public MapDefinition SelectedMap { get; set; }
    public int SelectedSlot = -1;

    public void SelectSlot( int selectedId )
    {
        Log.Info($" SelectSlot :: {selectedId}"); // retornando sempre 3
        SelectedSlot = selectedId;
    }

    public String IsActiveSlot(int slotId) 
    {   
        if ( slotId == SelectedSlot )
        {
            return "save-slot active";
        }
        
        return "save-slot";
    }

    private void Join()
    {
		// Rename to StartSession, only allow the host to init the level!
		Game.Instance.HostLobby();
    }
}
