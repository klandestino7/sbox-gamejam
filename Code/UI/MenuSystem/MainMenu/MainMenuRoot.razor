@using Sandbox.Menu
@using Sandbox.UI;
@namespace Gamejam.UI

@inherits Sandbox.UI.NavHostPanel

<root style="pointer-events: all">
    <div class="background" />

    <div class="navigator-canvas" slot="navigator-canvas" />
</root>

@code
{
	public MainMenuRoot()
    {
        DefaultUrl = "/";
	    AddDestination( "/", typeof( LandingPage ) );
	    AddDestination( "/new", typeof( HostGamePage ) );
	    AddDestination( "/settings", typeof( LandingPage ) );
    }
}
