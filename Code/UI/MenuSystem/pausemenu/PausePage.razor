@using Sandbox;
@using Sandbox.UI;

@namespace Gamejam.UI
@implements INavigatorPage

<root>
    <Page>
		<Header>
            <div
                class="logo-box"
            >
                <img class="logo" src="/ui/game_logo.png" />
            </div>
        </Header>
        <Body>
            <div class="inset column" style="width: 28%; position: absolute; left:0;">
                <div class="flex padding-extra gap column">
                    <button class="button " onclick=@(()=> Log.Info("okd"))><i>play_circle_outline</i>Resume</button>
                    <button class="button " onclick=@(()=> Log.Info("okd"))><i>settings</i>Settings</button>
                    <button class="button " onclick=@(()=> Log.Info("okd"))><i>dns</i>Credits</button>
                    <button class="button " onclick=@(()=> Log.Info("okd"))><i>power_settings_new</i>Disconnect</button>
                </div>
            </div>
        </Body>
    </Page>
</root>

